{
	"schemaVersion": 1,
	"id": "motionsuite",
	"version": "${version}",
	"name": "Motion Suite",
	"description": "Motion blur (OpenGL and VulkanMod) merged with ender pearl camera smoothing and crystal PvP guard. Client-side, visual only.",
	"authors": [
		"r3vy"
	],
	"contact": {
		"homepage": "https://github.com/0r3vy/Motionsuite",
		"sources": "https://github.com/0r3vy/Motionsuite",
		"issues": "https://github.com/0r3vy/Motionsuite/issues"
	},
	"license": "MIT",
	"icon": "assets/motionsuite/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.r3vy.motionsuite.MbClient"
		]
	},
	"mixins": [
		{
			"config": "motionsuite.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.1",
		"minecraft": "~1.21.11",
		"java": ">=21",
		"fabric-api": "*"
	},
	"suggests": {
		"vulkanmod": "*"
	}
}
